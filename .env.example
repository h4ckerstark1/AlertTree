# Public frontend configuration ONLY.
# Anything prefixed with VITE_ is bundled into the browser build and is visible to everyone.
# Never put secrets, API keys, tokens or credentials in this file or in any VITE_ variable.

# Base path for API requests. Keep it same-origin ("/api") so the BFF session cookie works.
VITE_API_BASE_URL=/api

# "true" = use clearly labeled demo data where no backend exists yet.
VITE_DEMO_MODE=true

# --- Development server only (NOT exposed to the browser; read by vite.config.ts) ---
# Where the dev proxy forwards /api requests (the Go API / BFF).
API_PROXY_TARGET=http://localhost:8080
